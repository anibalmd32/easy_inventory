{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Inventario fácil",
	"mainBinaryName": "easy-inventory",
	"version": "0.1.1",
	"identifier": "com.easy-inventory",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Inventario fácil",
				"width": 800,
				"height": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.rgba",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"sql": {
			"preload": ["sqlite:easy_inventory_storage.db"]
		}
	}
}
